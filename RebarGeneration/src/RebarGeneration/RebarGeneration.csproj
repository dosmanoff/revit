<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>RebarGeneration</AssemblyName>
    <RootNamespace>RebarGeneration</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <!-- Плюс обычные Debug/Release: CI собирает каждый проект простым `-c Release`. -->
    <Configurations>Debug;Release;Debug R2025;Debug R2026;Release R2025;Release R2026</Configurations>
    <!-- Сборка Windows-таргета на Linux-раннере CI — как в соседних плагинах репозитория. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <PropertyGroup Condition="$(Configuration.Contains('R2025'))">
    <RevitVersion>2025</RevitVersion>
    <DefineConstants>$(DefineConstants);REVIT2025</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="$(Configuration.Contains('R2026'))">
    <RevitVersion>2026</RevitVersion>
    <DefineConstants>$(DefineConstants);REVIT2026</DefineConstants>
  </PropertyGroup>

  <!-- Конфигурация без суффикса версии (CI, IDE по умолчанию) — собираем под 2025. -->
  <PropertyGroup Condition="'$(RevitVersion)' == ''">
    <RevitVersion>2025</RevitVersion>
    <DefineConstants>$(DefineConstants);REVIT2025</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <!-- Reference-only: настоящие DLL приезжают вместе с Revit в рантайме. -->
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="$(RevitVersion).*" ExcludeAssets="runtime" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="$(RevitVersion).*" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RebarGeneration.Contracts\RebarGeneration.Contracts.csproj" />
    <!--
      Чистая (Revit-free) раскладка по контуру с отверстиями. Ссылка на проект, а
      не на плагин SlabReinforcement: эта сборка алгоритмическая и уже покрыта
      тестами, переписывать сканлайн-клиппинг заново значило бы заводить второй,
      расходящийся счёт.
    -->
    <ProjectReference Include="..\..\..\SlabReinforcement.Geometry\SlabReinforcement.Geometry.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\samples\*.json" CopyToOutputDirectory="PreserveNewest">
      <Link>samples\%(Filename)%(Extension)</Link>
    </None>
  </ItemGroup>

</Project>
