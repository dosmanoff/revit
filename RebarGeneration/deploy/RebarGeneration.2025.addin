<?xml version="1.0" encoding="utf-8"?>
<RevitAddIns>
  <!--
    Регистрация внешнего приложения нужна не только ради кнопок на ленте: именно
    она загружает сборку в процесс Revit, благодаря чему агент достаёт
    RebarGeneration.Api из pyRevit Routes /exec по имени типа, без clr.AddReference.
  -->
  <AddIn Type="Application">
    <Name>RebarGeneration</Name>
    <Assembly>RebarGeneration.dll</Assembly>
    <AddInId>7C1D9F2A-4B63-4E58-9A11-5D0E2C7B8410</AddInId>
    <FullClassName>RebarGeneration.Application.RebarGenerationApp</FullClassName>
    <VendorId>DOSM</VendorId>
    <VendorDescription>Structural plugins</VendorDescription>
  </AddIn>
</RevitAddIns>
